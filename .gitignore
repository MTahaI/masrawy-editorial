.venv/
venv/

# 4) السجلات والملفات المؤقتة
*.log
*.tmp
*.bak
*.old

# 5) نماذج أولاما — ثقيلة ولا تصلح للمستودع
models/
*.gguf

# 6) النسخ الاحتياطية المحلية المتداخلة
backup_*/
workspace/
